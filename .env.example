# Local (manage.py default: config.settings_dev)
DEBUG=True
SECRET_KEY=change-me-to-a-long-random-string
ALLOWED_HOSTS=127.0.0.1,localhost
WIDGET_BASE_URL=http://127.0.0.1:8000

# Optional — agar settings_dev DATABASES ni o‘qimasa:
# POSTGRES_DB=hotel-management
# POSTGRES_USER=postgres
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432

# Production (DJANGO_SETTINGS_MODULE=config.settings_prod)
# DEBUG=False
# SECRET_KEY=<uzun-random>
# ALLOWED_HOSTS=pms.example.uz,www.pms.example.uz
# CSRF_TRUSTED_ORIGINS=https://pms.example.uz,https://www.pms.example.uz
# WIDGET_BASE_URL=https://pms.example.uz
# POSTGRES_DB=hotel_management
# POSTGRES_USER=
# POSTGRES_PASSWORD=
# POSTGRES_HOST=localhost
# POSTGRES_PORT=5432
# SECURE_SSL_REDIRECT=True
