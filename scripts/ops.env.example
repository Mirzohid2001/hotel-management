# Copy to scripts/ops.env on the SERVER (never commit ops.env).
#   cp scripts/ops.env.example scripts/ops.env
#   nano scripts/ops.env

# App root on the VPS
APP_DIR=/home/hotel/hotel-management

# Python venv with Django + deps
VENV_DIR=/home/hotel/hotel-management/venv

# Where dated backups are stored (keep OFF the git tree if disk is tight —
# e.g. /var/backups/hotel-pms)
BACKUP_DIR=/var/backups/hotel-pms

# Keep this many successful backup folders (older ones are deleted)
KEEP_BACKUPS=14

# Postgres — usually same as production .env
POSTGRES_DB=hotel_management
POSTGRES_USER=hotel
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
# Prefer ~/.pgpass or leave empty and use peer auth as postgres user.
# POSTGRES_PASSWORD=  # optional; better: sudo -u postgres pg_dump

# Media uploads relative to APP_DIR
MEDIA_DIR=media

# Django settings module for migrate / collectstatic
DJANGO_SETTINGS_MODULE=config.settings_prod

# How to reload the app after deploy (pick ONE that matches your server).
# MUST be quoted if it contains spaces.
# Examples:
#   RESTART_CMD="systemctl restart hotel-gunicorn"
#   RESTART_CMD="systemctl restart gunicorn"
# Leave empty to skip restart (safer until you set the real unit name).
RESTART_CMD="systemctl restart hotel-gunicorn"

# Optional: run as this Linux user (empty = current user)
# RUN_AS=hotel
